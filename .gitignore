# Knowledge Islands managed ignores.
# Edit the owning skill contract, not the marker-bounded blocks below.

# ki-repo:ignore:ki-repo:start
# Generated reports, disposable tmp output, local metadata, logs, and runtime projections.
reports/
!/+/_WORK/*/reports/
!/+/_WORK_REVIEW/*/reports/
tmp/
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
.claude/settings.local.json
*.log
.claude/skills/*
.agents/skills/*
!.agents/skills/ki-self/
!.agents/skills/ki-self/**
# ki-repo:ignore:ki-repo:end

# ki-repo:ignore:ki-engineering:start
# TypeScript/Bun dependencies, build output, caches, logs, and real environment files.
node_modules/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env*.example
# ki-repo:ignore:ki-engineering:end

# ki-repo:ignore:ki-repo-website:start
# Generated website build output.
dist/
# ki-repo:ignore:ki-repo-website:end

# ki-repo:ignore:ki-repo-website-cloudflare:start
# Cloudflare local runtime state and local development secrets.
.wrangler/
.dev.vars
