{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".ncurc.cjs", ".claude/skills/**", ".agents/skills/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [".dependency-cruiser.ts"]
    },
    "apps/site": {
      "entry": ["eleventy.config.ts!", "src/_data/**/*.ts!", "scripts/**/*.ts!"],
      "project": ["**/*.ts", "**/*.css"]
    }
  },
  "husky": { "config": [".githooks/pre-commit", ".githooks/commit-msg"] }
}
