{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".ncurc.cjs", ".claude/skills/**", ".agents/skills/**"],
  "ignoreDependencies": ["@commitlint/cli", "lint-staged", "syncpack"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [".dependency-cruiser.ts"]
    },
    "apps/site": {
      "entry": ["eleventy.config.ts!", "src/_data/**/*.ts!", "scripts/**/*.ts!"],
      "project": ["**/*.ts", "**/*.css"]
    }
  }
}
