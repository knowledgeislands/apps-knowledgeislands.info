<footer class="site-footer" data-theme="night">
  <div class="page-container">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/">
          <img src="/assets/images/ki-design/logo-roundel.png" width="44" height="44" alt="" />
          <span>Knowledge Islands</span>
        </a>
        <p>A model for building, governing, and evolving knowledge across individuals, teams, and generations.</p>
        <p class="foot-meta">Conventions · Processes · Activities · Agents · Tools</p>
      </div>

      {%- for group in site.nav.groups %}
      <nav aria-labelledby="foot-{{ group.label | lower }}">
        <h2 id="foot-{{ group.label | lower }}">The {{ group.label }}</h2>
        <ul>
          {%- if loop.first %}
          <li><a href="/">Home</a></li>
          {%- endif %}
          {%- for item in group.items %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      {%- endfor %}
    </div>

    <div class="foot-base">
      <p>© {{ site.title }}</p>
      <p class="foot-tagline">{{ site.tagline }}</p>
    </div>
  </div>
</footer>
