{#
  The site header: the logo roundel and wordmark, the Voyage and Atlas groups from `site.nav`, and the
  one brass call to action. Below 1100 px the groups fold into a Menu disclosure, a <details>, so it
  opens without JavaScript; assets/js/site.js only adds Escape-to-close.

  The night toggle (GDR-KI-DESIGN-025) is a two-state toggle button: pressed means the page shows the
  night chart. It ships `hidden` and assets/js/site.js reveals it, so without JavaScript there is no inert
  control and the page simply follows the operating system.
#}
{% from "macros/icons.njk" import kiGlyph %}
<header class="site-header" data-theme="night">
  <div class="header-wrap">
    <a class="brand" href="/">
      <img src="/assets/images/ki-design/logo-roundel.png" width="44" height="44" alt="" />
      <span>Knowledge Islands</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      {%- for group in site.nav.groups %}
      <div class="nav-group">
        <span class="nav-label" id="nav-{{ group.label | lower }}">{{ group.label }}</span>
        <ul aria-labelledby="nav-{{ group.label | lower }}">
          {%- for item in group.items %}
          <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </nav>
    <a class="btn btn-brass header-cta" href="{{ site.nav.cta.href }}">{{ site.nav.cta.label }}</a>
    <button class="theme-toggle" type="button" aria-label="Night chart" aria-pressed="false" hidden>{{ kiGlyph("theme", 20) }}</button>

    <details class="nav-menu">
      <summary>{{ kiGlyph("menu", 20) }}<span class="menu-label">Menu</span></summary>
      <nav class="menu-panel" aria-label="Main navigation, compact">
        {%- for group in site.nav.groups %}
        <div>
          <span class="nav-label">{{ group.label }}</span>
          <ul>
            {%- for item in group.items %}
            <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {%- endfor %}
          </ul>
        </div>
        {%- endfor %}
        <a class="btn btn-brass" href="{{ site.nav.cta.href }}">{{ site.nav.cta.label }}</a>
      </nav>
    </details>
  </div>
</header>
