<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    {% include "partials/seo-meta.njk" %}
    <link rel="icon" href="/assets/images/ki-design/favicon.png" />
    {#- Cormorant Garamond for display (24 px and up), Cormorant SC for labels, Inter for body (ki-design DESIGN.md). #}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Cormorant+SC:wght@600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    {#- Before any paint: apply a night or day chart the visitor chose with the header toggle, so a forced theme
        never flashes the OS one first. No stored choice, or no storage, leaves the root to follow the OS. #}
    <script>try{var t=localStorage.getItem("ki-theme");if(t==="light"||t==="night")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
    <link rel="stylesheet" href="/assets/css/main.css" />
    <script src="/assets/js/site.js" defer></script>
  </head>
  <body>
    {% include "ki-design/glyphs.svg" %}
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "partials/nav.njk" %}
    <main id="main" class="site-main">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
  </body>
</html>
