    installer: 'https://raw.githubusercontent.com/knowledgeislands/tools-ki/v0.13.0/install.sh',
    manual: 'https://github.com/knowledgeislands/tools-ki/blob/v0.13.0/README.md',
    changelog: 'https://github.com/knowledgeislands/tools-ki/blob/v0.13.0/CHANGELOG.md',
    icon: 'anchor',
    accent: 'gold'
  },
