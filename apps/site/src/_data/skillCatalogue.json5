    {
      "name": "Work",
      "skills": [
        {
          "name": "ki-coordination",
          "description": "Govern coordinating work under the Knowledge Islands work model: the responsive coordinator and its turn budget, the work levels and forms with their ids, openers and bootstrap, the seven states and the receive words, the mark and the one Summary with its status table and footer, the reply format, the closing glyph banner and thread line, On hold with its Stop, the work package and its message queue, route receipt and the inbox check, re-anchoring after compaction, decision classes and their life cycle, change documents, Finished, the working rules, and the three reply forms every session uses. Use while coordinating any explicitly opened work package to give a summary or banner or strike the mark, or to decide how any session replies; `ki-delegation` owns the background runs the coordinator launches.",
          "kind": "Governance",
          "fields": [
            {
              "label": "Kind",
              "value": "Governance"
            },
            {
              "label": "Applicability",
              "value": "Declaration Only"
            },
            {
              "label": "Arguments",
              "value": "`audit <repo> | conform <repo> | drain | educate <repo> | help | hold | mark [only | status only] [no art] | receive | refresh | resume | send | status [no art] | summary [since <time>] [no art]`"
            },
            {
              "label": "Dependencies",
              "value": "`ki-delegation`, `ki-work-package`"
            },
            {
              "label": "Runtime",
              "value": "Portable"
            }
          ],
          "areas": [
            {
              "slug": "coordination",
              "title": "Coordination",
              "group": "Delegation and programme"
            }
          ]
        },
        {
          "name": "ki-meeting",
          "description": "Call, hold and close a meeting: a room at one node of the work tree where named participants, each reaching it by the first route that works, make, review or look back on something together, in sittings with a roll call, one file per message, check-ins and minutes, while decisions go to a change document. Use to call a meeting, open, adjourn or join a sitting, or close one, and to choose a workshop, review or retrospective; use `ki-coordination` for coordinating work and its reports, and `ki-work-package` for the package a meeting serves.",
          "kind": "Process",
          "fields": [
            {
              "label": "Kind",
              "value": "Process"
            },
            {
              "label": "Applicability",
              "value": "Invocation Only"
            },
            {
              "label": "Arguments",
              "value": "`adjourn <meeting> | call <node id> <slug> | close <meeting> | help | join <meeting> | sit <meeting>`"
            },
            {
              "label": "Dependencies",
              "value": "None"
            },
            {
              "label": "Runtime",
              "value": "Portable"
            }
          ],
          "areas": [
            {
              "slug": "coordination",
              "title": "Coordination",
              "group": "Delegation and programme"
            }
          ]
        },
        {
          "name": "ki-trade",
          "description": "Operate one repository's side of a declared cross-repository trade: prepare, inspect, submit, receive, release, or prune a work or knowledge record. Use for one concrete trade action; `ki-trades` owns record and route governance, while `ki-work next` owns receiver disposition.",
          "kind": "Process",
          "fields": [
            {
              "label": "Kind",
              "value": "Process"
            },
            {
              "label": "Applicability",
              "value": "Invocation Only"
