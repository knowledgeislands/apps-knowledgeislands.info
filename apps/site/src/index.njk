---
layout: layouts/base.njk
description: Knowledge Islands is a model for building, governing, and evolving knowledge across individuals, teams, and generations — treating knowledge not as a filing problem but as a civilisation question.
---
{% from "macros/icons.njk" import kiGlyph %}
{% from "macros/painting.njk" import paintingPicture %}
{#
  The Voyage home, after the ki-design site preview (examples/site-preview/index.html at 002a623).
  The copy is the site's own, in its own order; the preview's look is applied around it.

  The Port, not the Harbour: Knowledge Islands Principal enacted the Port as the island's point of entry
  and exit in GDR-KI-PRINCIPAL-010, so the copy and the vendored map art now agree.

  The painting is the legend and the chart is the map (owner direction, 18 October 2026): the page opens on
  the painting, with the hero copy in a soft pool of dusk over the sea, and the engraved chart is drawn in the
  Arcadia section further down, so the painting appears once (KI-WEBSITE-SITE-045).

  The Capital is the island's civic heart, holding the Library and the Council Hall (GDR-KI-PRINCIPAL-011);
  the vendored chart names it so, and is drawn as ki-design drew it.
#}

<!-- ═══ HERO: the painting, the legend ═══ -->
<section class="hero painted-hero" data-theme="night" aria-labelledby="hero-title">
  <div class="painted-hero-stage">
    <figure class="hero-painting">
      {{ paintingPicture(arcadiaPainting, "(max-width: 720px) 134vw, (min-width: 1672px) 1672px, 100vw", "eager", "high") }}
    </figure>
    <div class="hero-copy">
      <p class="kicker">Knowledge Islands</p>
      <h1 id="hero-title" class="display-xl">Knowledge is a civilisation question.</h1>
      <hr class="brass-rule" />
      <p class="lead">Not a filing problem. Not a search problem. Not a productivity hack. Knowledge Islands is a model for building, governing, and evolving knowledge — across individuals, teams, and generations.</p>
      <div class="btn-row">
        <a href="/philosophy/" class="btn btn-brass">Explore the Philosophy</a>
        <a href="/model/" class="btn btn-outline">See the Model</a>
        <a href="/docs/get-started/" class="btn btn-outline">Get Started</a>
      </div>
    </div>
  </div>
</section>

<!-- The text equivalent of the painting and the chart, and the phone-width form of the chart's cartouches. -->
<section class="districts" data-theme="night" aria-labelledby="districts-title">
  <div class="page-container">
    <h2 id="districts-title">Districts of Arcadia</h2>
    <ul>
      <li>{{ kiGlyph("capital") }}<div><strong>The Capital</strong><span>Library · Council Hall</span></div></li>
      <li>{{ kiGlyph("port") }}<div><strong>The Port</strong><span>Capture · entry &amp; exchange</span></div></li>
      <li>{{ kiGlyph("observatory") }}<div><strong>The Observatory</strong><span>Reflect · insight</span></div></li>
      <li>{{ kiGlyph("streams") }}<div><strong>The Streams</strong><span>Knowledge in motion</span></div></li>
      <li>{{ kiGlyph("ancient-forest") }}<div><strong>The Ancient Forest</strong><span>Wisdom · never built on</span></div></li>
    </ul>
  </div>
</section>

<!-- ═══ THE THREE LAYERS, drawn as depth ═══ -->
<section id="foundation" class="section on-parchment" aria-labelledby="foundation-title">
  <div class="page-container">
    <div class="section-head center">
      <p class="kicker">The Foundation</p>
      <h2 id="foundation-title" class="display-m">Three layers. One journey.</h2>
      <p class="lead">Knowledge Islands distinguishes carefully between information, knowledge, and wisdom — because the work of moving between them is precisely what islands are for.</p>
    </div>

    <svg class="profile" viewBox="0 -34 1200 270" role="img" aria-labelledby="profile-t">
      <title id="profile-t">An island in cross-section, rising from the shallows through inhabited land to the ancient forest on the high ground: information, knowledge, wisdom.</title>
      <defs>
        <pattern id="strata" width="40" height="13" patternUnits="userSpaceOnUse"><path d="M0 12.5 H40" stroke="#1a2030" stroke-opacity="0.16" stroke-width="1"/></pattern>
      </defs>
      <svg class="gs" x="1150" y="-32" width="30" height="30" viewBox="0 0 24 24" style="color:#8a5a12" aria-hidden="true"><use href="#ki-celestial-guide"/></svg>

      <!-- Terrace 3: ancient forest and high stone (wisdom) -->
      <polygon points="806,64 1182,64 1196,52 820,52" fill="#4f7a57"/>
      <polygon points="806,64 1182,64 1196,52 820,52" fill="#f5efe0" fill-opacity="0.18"/>
      <rect x="806" y="64" width="376" height="150" fill="#8f7f68"/>
      <rect x="806" y="64" width="376" height="150" fill="url(#strata)"/>
      <rect x="806" y="64" width="376" height="7" fill="#3d6346"/>
      <polygon points="1182,64 1196,52 1196,202 1182,214" fill="#6e6152"/>
      <path d="M806 64 H1182 V214 H806 Z M1182 64 L1196 52 V202 L1182 214" fill="none" stroke="#1a2030" stroke-opacity="0.55" stroke-width="1"/>
      <polygon points="1040,52 1090,-2 1140,52" fill="#a8a196"/><polygon points="1090,-2 1140,52 1100,52" fill="#6f695e"/>
      <polygon points="1080,10 1090,-2 1100,10 1094,8 1088,13" fill="#f5efe0"/>
      <polygon points="1040,52 1090,-2 1140,52" fill="none" stroke="#1a2030" stroke-opacity="0.6"/>
      <g stroke="#1a2030" stroke-opacity="0.6" stroke-width="0.8" stroke-linejoin="round">
        <polygon points="842,58 852,34 862,58" fill="#355c40"/><polygon points="862,60 874,30 886,60" fill="#3d6a49"/>
        <polygon points="1132,58 1142,36 1152,58" fill="#355c40"/><polygon points="1150,60 1161,34 1172,60" fill="#3d6a49"/>
        <polygon points="1008,60 1018,40 1028,60" fill="#355c40"/>
      </g>
      <svg x="900" y="-14" width="96" height="96" viewBox="0 0 24 24" class="gs" aria-hidden="true" style="stroke:#f5efe0;stroke-width:3"><use href="#ki-ancient-forest"/></svg>
      <svg x="900" y="-14" width="96" height="96" viewBox="0 0 24 24" class="gs" aria-hidden="true" style="stroke:#1a2030;stroke-width:0.85"><use href="#ki-ancient-forest"/></svg>

      <!-- Terrace 2: inhabited land (knowledge) -->
      <polygon points="404,122 812,122 826,110 418,110" fill="#a9b97c"/>
      <polygon points="404,122 812,122 826,110 418,110" fill="#f5efe0" fill-opacity="0.18"/>
      <rect x="404" y="122" width="408" height="96" fill="#9d8c72"/>
      <rect x="404" y="122" width="408" height="96" fill="url(#strata)"/>
      <rect x="404" y="122" width="408" height="7" fill="#7f8c5c"/>
      <path d="M404 122 H812 V218 H404 Z" fill="none" stroke="#1a2030" stroke-opacity="0.55"/>
      <path d="M430 116 C 520 108, 640 120, 790 112" fill="none" stroke="#8a5a12" stroke-width="1.6" stroke-dasharray="0.1 5" stroke-linecap="round"/>
      <g class="gs" aria-hidden="true">
        <svg x="456" y="66" width="48" height="48" viewBox="0 0 24 24" style="stroke:#f5efe0;stroke-width:3"><use href="#ki-library"/></svg>
        <svg x="456" y="66" width="48" height="48" viewBox="0 0 24 24" style="stroke:#1a2030;stroke-width:1.05"><use href="#ki-library"/></svg>
        <svg x="690" y="68" width="46" height="46" viewBox="0 0 24 24" style="stroke:#f5efe0;stroke-width:3"><use href="#ki-council-hall"/></svg>
        <svg x="690" y="68" width="46" height="46" viewBox="0 0 24 24" style="stroke:#1a2030;stroke-width:1.05"><use href="#ki-council-hall"/></svg>
      </g>
      <g fill="#c8963c"><circle cx="530" cy="112" r="2.4"/><circle cx="650" cy="116" r="2.4"/><circle cx="760" cy="113" r="2.4"/></g>

      <!-- Terrace 1: coast and shallows (information) -->
      <polygon points="40,176 418,176 432,166 54,166" fill="#e4d4a6"/>
      <polygon points="40,176 418,176 432,166 54,166" fill="#f5efe0" fill-opacity="0.2"/>
      <rect x="40" y="176" width="378" height="44" fill="#a99a80"/>
      <rect x="40" y="176" width="378" height="44" fill="url(#strata)"/>
      <rect x="40" y="176" width="378" height="6" fill="#bfae84"/>
      <path d="M40 176 H418 V220 H40 Z" fill="none" stroke="#1a2030" stroke-opacity="0.55"/>
      <g fill="#1a2030" fill-opacity="0.4"><circle cx="120" cy="171" r="1"/><circle cx="160" cy="169" r="1"/><circle cx="210" cy="172" r="1"/><circle cx="300" cy="170" r="1"/><circle cx="350" cy="172" r="1"/><circle cx="250" cy="168" r="1"/></g>
      <g aria-hidden="true">
        <svg x="200" y="122" width="44" height="44" viewBox="0 0 24 24" class="gs" style="stroke:#f5efe0;stroke-width:3"><use href="#ki-port"/></svg>
        <svg x="200" y="122" width="44" height="44" viewBox="0 0 24 24" class="gs" style="stroke:#1a2030;stroke-width:1.05"><use href="#ki-port"/></svg>
      </g>
      <path d="M4 180 H54 M12 180 V214 M28 180 V214 M44 180 V214" stroke="#5e5142" stroke-width="2"/>
      <svg x="-6" y="190" width="26" height="26" viewBox="0 0 24 24" class="gs" aria-hidden="true" style="stroke:#1a2030;stroke-width:1.5"><use href="#ki-vessel"/></svg>
      <g fill="#c8963c"><circle cx="270" cy="168" r="2.4"/><circle cx="90" cy="170" r="2.4"/></g>

      <!-- the sea, and data beneath it -->
      <rect x="0" y="206" width="1200" height="30" fill="#d6e3e1"/>
      <path d="M0 206 H1200" stroke="#317070" stroke-opacity="0.5"/>
      <g fill="none" stroke="#1b3a5c" stroke-opacity="0.35" stroke-linecap="round"><path d="M70 220 q6 -3 12 0"/><path d="M180 226 q6 -3 12 0"/><path d="M330 218 q6 -3 12 0"/><path d="M520 226 q6 -3 12 0"/><path d="M690 220 q6 -3 12 0"/><path d="M880 228 q6 -3 12 0"/><path d="M1040 219 q6 -3 12 0"/><path d="M1150 227 q6 -3 12 0"/></g>
    </svg>

    <div class="layers">
      <article class="layer">
        <div class="layer-tag">{{ kiGlyph("port", 20) }}<span class="label">coast and shallows</span></div>
        <h3 class="display-s">Information</h3>
        <p>Organised data. It exists independently of the reader — databases, documents, feeds, records. Structure without meaning.</p>
        <p class="aside">The terrain before it is charted.</p>
      </article>
      <article class="layer">
        <div class="layer-tag">{{ kiGlyph("library", 20) }}<span class="label">inhabited land</span></div>
        <h3 class="display-s">Knowledge</h3>
        <p>Information interpreted and applied. It requires you — your context, your connections, your lived experience. It changes when you do.</p>
        <p class="aside">The island as it is inhabited.</p>
      </article>
      <article class="layer">
        <div class="layer-tag">{{ kiGlyph("ancient-forest", 20) }}<span class="label">ancient forest and high stone</span></div>
        <h3 class="display-s">Wisdom</h3>
        <p>Knowledge used well. It is distinctly human, and it outlives you. It emerges through reflection over time — and across generations.</p>
        <p class="aside">The ancient forest at the island's heart.</p>
      </article>
    </div>
  </div>
</section>

<!-- ═══ THE CYCLE, on a tide loop ═══ -->
<section id="cycle" class="section on-mist rule-top" aria-labelledby="cycle-title">
  <div class="page-container">
    <div class="section-head center">
      <p class="kicker">The Cycle</p>
      <h2 id="cycle-title" class="display-m">Knowledge needs tending.</h2>
      <p class="lead">Information doesn't become knowledge by itself. Islands stay alive through a continuous cycle — running at different cadences, in parallel.</p>
    </div>

    <svg class="tide" viewBox="0 0 1200 190" aria-hidden="true">
      <g fill="none" stroke="#317070" stroke-linecap="round">
        <path d="M187 44 H1013 A56 56 0 0 1 1013 156 H187 A56 56 0 0 1 187 44 Z" stroke-width="1.5"/>
        <path d="M187 52 H1013 A48 48 0 0 1 1013 148 H187 A48 48 0 0 1 187 52 Z" stroke-width="1" stroke-opacity="0.35" stroke-dasharray="2 6"/>
        <path d="M388 38 l10 6 l-10 6 M802 38 l10 6 l-10 6" stroke-width="1.5"/>
        <path d="M612 150 l-10 6 l10 6" stroke-width="1.5"/>
        <path d="M1063 94 l6 10 l6 -10" stroke-width="1.5"/>
        <path d="M137 106 l-6 -10 l-6 10" stroke-width="1.5"/>
      </g>
      <g>
        <circle cx="187" cy="44" r="28" fill="#eef1f5" stroke="#c8963c"/>
        <svg x="175" y="32" width="24" height="24" viewBox="0 0 24 24" class="gs" style="color:#1a2030"><use href="#ki-port"/></svg>
        <circle cx="600" cy="44" r="28" fill="#eef1f5" stroke="#c8963c"/>
        <svg x="588" y="32" width="24" height="24" viewBox="0 0 24 24" class="gs" style="color:#1a2030"><use href="#ki-route"/></svg>
        <circle cx="1013" cy="44" r="28" fill="#eef1f5" stroke="#c8963c"/>
        <svg x="1001" y="32" width="24" height="24" viewBox="0 0 24 24" class="gs" style="color:#1a2030"><use href="#ki-observatory"/></svg>
      </g>
      <text x="600" y="184" text-anchor="middle" font-family="'Cormorant SC', Georgia, serif" font-size="16" font-weight="600" letter-spacing="2.4" fill="#317070">and the tide returns to the port</text>
    </svg>

    <ol class="cycle">
      <li>
        <span class="roundel" aria-hidden="true">{{ kiGlyph("port") }}</span>
        <div>
          <p class="step-place"><span class="step-num">01</span><span class="label">The Port</span></p>
          <h3 class="display-s">Capture</h3>
          <p>Information arrives without immediate judgment. The Port receives everything before the Library decides what belongs. No filtering at the gate — only routing.</p>
        </div>
      </li>
      <li>
        <span class="roundel" aria-hidden="true">{{ kiGlyph("route") }}</span>
        <div>
          <p class="step-place"><span class="step-num">02</span><span class="label">The Routes</span></p>
          <h3 class="display-s">Connect</h3>
          <p>Material is contextualised and linked to existing knowledge. This is the transformation step — where received information becomes owned knowledge. Links form. Meaning emerges.</p>
        </div>
      </li>
      <li>
        <span class="roundel" aria-hidden="true">{{ kiGlyph("observatory") }}</span>
        <div>
          <p class="step-place"><span class="step-num">03</span><span class="label">The Observatory</span></p>
          <h3 class="display-s">Reflect</h3>
          <p>Periodic review surfaces what's stale, updates what's changed, retires what's obsolete. Reflection is how the island stays honest — about what it knows and what it no longer does.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- ═══ THE HOME: the Capital as a plate ═══ -->
<section id="home" class="section on-parchment rule-top" aria-labelledby="home-title">
  <div class="page-container home-grid">
    <div class="home-copy">
      <p class="kicker">The Home</p>
      <h2 id="home-title" class="display-m" style="margin-bottom: 1.5rem;">An island has structure.</h2>
      <p>A Knowledge Island isn't a folder. It has a <strong>Capital</strong> — a civic centre with a Library at its heart and a Council Hall for governance. Knowledge enters and leaves through the <strong>Port</strong>, moves through <strong>Streams</strong> while it's in motion, and settles into the Library when it's canonical.</p>
      <blockquote class="quote"><p>"The structure is not bureaucracy. It's cartography — a map that tells you where you are."</p></blockquote>
      <a class="link-arrow" href="/philosophy/">Read the full philosophy {{ kiGlyph("arrow", 20) }}</a>
    </div>

    <figure class="deckle" data-theme="light" aria-labelledby="capital-cap">
      <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
      <div class="plate-head"><span class="dot" aria-hidden="true"></span><span class="display-xs" id="capital-cap">The Capital</span><span class="meta">Plate I</span></div>

      <p class="zone-group-label">Library</p>
      <div class="zone-row">
        <div class="zone">{{ kiGlyph("calendar", 20) }}<div><strong>Calendar</strong><span>Time-bound</span></div></div>
        <div class="zone">{{ kiGlyph("library", 20) }}<div><strong>Pillars</strong><span>Owned knowledge</span></div></div>
        <div class="zone">{{ kiGlyph("resources", 20) }}<div><strong>Resources</strong><span>External reference</span></div></div>
      </div>
      <div class="zone">{{ kiGlyph("council-hall", 20) }}<div><strong>Council Hall</strong><span>Governance space — decisions, not storage</span></div></div>

      <hr class="dash-divide" />

      <div class="zone-row zone-row-2">
        <div class="zone">{{ kiGlyph("streams", 20) }}<div><strong>Streams</strong><span>Knowledge in motion</span></div></div>
        <div class="zone">{{ kiGlyph("port", 20) }}<div><strong>Port</strong><span>Entry and exit</span></div></div>
      </div>
    </figure>
  </div>
</section>

<!-- ═══ TERRITORIES & AGENTS ═══ -->
<section id="wider" class="section lattice-bg" data-theme="night" aria-labelledby="wider-title">
  <div class="page-container">
    <div class="section-head center">
      <p class="kicker">The Wider Picture</p>
      <h2 id="wider-title" class="display-m">Islands don't stand alone.</h2>
      <p class="lead">Islands in proximity form archipelagos. Islands under shared governance form territories. And within each island, humans and artificial agents work together — through different interfaces, with different roles, but in the same cycle.</p>
    </div>

    <div class="cards-4">
      <article class="card-night">
        <span class="roundel" aria-hidden="true">{{ kiGlyph("island") }}</span>
        <h3 class="display-xs">Island</h3>
        <p>A discrete, self-contained body of knowledge with defined boundaries and internal geography. Operates its own cycle independently.</p>
      </article>
      <article class="card-night">
        <span class="roundel" aria-hidden="true">{{ kiGlyph("capital") }}</span>
        <h3 class="display-xs">Territory</h3>
        <p>Islands organised and governed together. One island holds governance infrastructure for the whole — the Principal Island.</p>
      </article>
      <article class="card-night">
        <span class="roundel" aria-hidden="true">{{ kiGlyph("archipelago") }}</span>
        <h3 class="display-xs">Archipelago</h3>
        <p>A geographic grouping of islands by proximity or shared character. Distinct from territory — geography and governance are orthogonal structures that overlap without being the same.</p>
      </article>
      <article class="card-night">
        <span class="roundel" aria-hidden="true">{{ kiGlyph("route") }}</span>
        <h3 class="display-xs">Agents</h3>
        <p>Human agents originate meaning and hold ratification authority. AI agents extend scale and recall. Both work in the same cycle — through different interfaces.</p>
      </article>
    </div>

    <div class="center"><a href="/model/" class="btn btn-outline">Explore the Model</a></div>
  </div>
</section>

<!-- ═══ ARCADIA: the painting in the hero is the legend; the chart here is the map ═══ -->
<section id="arcadia" class="section arcadia-band" data-theme="night" aria-labelledby="arcadia-title">
  <div class="page-container arcadia-copy center">
    <svg class="compass-mark ki-glyph" viewBox="0 0 24 24" aria-hidden="true"><use href="#ki-compass"/></svg>
    <p class="kicker">Arcadia</p>
    <h2 id="arcadia-title" class="display-m">Arcadia is the living instance.</h2>
    <p class="lead">The canonical Knowledge Island of Knowledge Islands — a working example of the model in practice. Every standard described here is implemented in Arcadia.</p>
    <div class="btn-row">
      <a href="/philosophy/" class="btn btn-brass">Start with Philosophy</a>
      <a href="/model/" class="btn btn-outline">Explore the Model</a>
      <a href="/projects/" class="btn btn-outline">See the Projects</a>
    </div>
  </div>
  <div class="page-container center chart-kicker">
    <p class="kicker">The chart</p>
  </div>
  <figure class="chart-map arcadia-chart">
    {% include "ki-design/hero-arcadia.svg" %}
    <figcaption class="meta">{{ kiGlyph("compass", 20) }}<span>Arcadia, drawn from its hex map in the Modern tile set.</span></figcaption>
  </figure>
</section>

<!-- ═══ THE VOYAGE, in order: only pages that exist ═══ -->
<section id="journey" class="section on-parchment rule-top" aria-labelledby="journey-title">
  <div class="page-container">
    <div class="section-head center">
      <p class="kicker">The Voyage</p>
      <h2 id="journey-title" class="display-m">Three steps, in order.</h2>
    </div>
    {%- set voyage = [
      { href: "/philosophy/", glyph: "celestial-guide", title: "The Philosophy", d: "The three layers, the cycle, and the geography of knowledge." },
      { href: "/model/", glyph: "island", title: "The Model", d: "Conventions, Processes, Activities, Agents, and Tools." },
      { href: "/docs/get-started/", glyph: "compass", title: "Get Started", d: "Stand up your own island: the harness, the repositories, and the first thing worth doing with them." }
    ] %}
    <ol class="rail" style="--rail-steps: {{ voyage | length }};">
      {%- for step in voyage %}
      <li{% if loop.first %} class="current"{% endif %}>
        <a href="{{ step.href }}">
          <span class="hexbadge">
            <svg class="hexframe" viewBox="0 0 56 64" aria-hidden="true">
              {%- if loop.first %}
              <polygon points="28,1.5 54.5,16.75 54.5,47.25 28,62.5 1.5,47.25 1.5,16.75" fill="#0f2440" stroke="#c8963c" stroke-width="2"/>
              <polygon points="28,6.5 50,19.25 50,44.75 28,57.5 6,44.75 6,19.25" fill="none" stroke="#c8963c" stroke-opacity="0.45" stroke-width="1"/>
              {%- else %}
              <polygon points="28,1.5 54.5,16.75 54.5,47.25 28,62.5 1.5,47.25 1.5,16.75" style="fill: var(--color-paper);" stroke="#c8963c" stroke-width="1"/>
              {%- endif %}
            </svg>
            {{ kiGlyph(step.glyph) }}
          </span>
          <span class="rail-num">0{{ loop.index }}</span>
          <strong>{{ step.title }}</strong>
          <span class="rail-d">{{ step.d }}</span>
          {%- if loop.first %}<span class="here">Start here</span>{% endif %}
        </a>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
