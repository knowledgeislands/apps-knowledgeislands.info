# Generated from the released tools in src/_data/projects.json5 by src/redirects.njk — edit the registry, not this file.
#
# Machine routes: each /install/<tool> is this site's stable endpoint for a tool
# whose installer is published at an immutable release tag in its own repository.
{% for tool in tools %}/install/{{ tool.slug }} {{ tool.installer }} 302
{% endfor %}
# Repository bootstrap, owned by the KI Agentic Harness.
/harness/bootstrap https://raw.githubusercontent.com/knowledgeislands/ki-agentic-harness/main/skills/keystone/ki-bootstrap/scripts/repo-bootstrap.sh 302

# Retired sections.
#
# The specifications corpus is not yet ready to publish here (KI-WEB-SITE-021).
/specifications / 302

# Techne Principal was retired and archived (KI-ARCADIA-ECO-008); its engineering
# discipline now lives in Knowledge Islands Principal, so its project page points there.
/projects/ki-techne-principal /projects/ki-principal/ 301

# Arcadia Principal's repository was renamed ki-principal in the post-move
# estate rename, so its project page moved with the slug.
/projects/ki-arcadia-principal /projects/ki-principal/ 301

# ki-plugins was retired and archived (KI-ARCADIA-ECO-010); the harness is installed
# through the ki CLI or npx skills add, so its project page points to the harness.
/projects/ki-plugins /projects/ki-agentic-harness/ 301

# Tooling was merged into Projects (KI-WEB-SITE-020). A tool is a project that
# ships a binary, so /tooling/<slug>/ becomes /projects/<slug>/. The two pages
# that were task guidance filed under released tools follow the guidance move
# below, so they point at their final home rather than at a redirect.
# Cloudflare takes the first matching rule, so the named paths precede the splat.
/tooling/harnesses /docs/ki-agentic-harness/installing-a-harness/ 301
/tooling/guidance /docs/ki-agentic-harness/repositories/ 301
{% for tool in tools %}/tooling/{{ tool.slug }} /projects/{{ tool.slug }}/ 301
{% endfor %}/tooling / 301

# Guidance dissolved into the projects that own it (KI-WEB-SITE-025). Every one of
# these URLs was published, so each gets a rule; the four pages whose material
# merged into another page redirect to the page that now carries it. The targets
# were /projects/<slug>/<page>/ when this block was written and were repointed at
# /docs/<section>/<page>/ when the guides moved again (KI-WEB-SITE-037), so an
# address published two moves ago still resolves in one hop rather than two.
/guidance/cli /docs/ki/command-groups/ 301
/guidance/cli/commands /docs/ki/commands/ 301
/guidance/cli/capability-lifecycle /docs/ki/capability-lifecycle/ 301
/guidance/cli/local-commands /docs/ki/local-commands/ 301
/guidance/cli/update-upgrade /docs/ki/update-upgrade/ 301
/guidance/cli/operator-guides /docs/ki/operator-guides/ 301
/guidance/cli/chatgpt-local-capture /docs/ki/chatgpt-local-capture/ 301
/guidance/harnesses /docs/ki-agentic-harness/installing-a-harness/ 301
/guidance/repositories /docs/ki-agentic-harness/repositories/ 301
/guidance/skills /docs/ki-agentic-harness/skills/ 301
/guidance/skills/by-outcome /docs/ki-agentic-harness/skills-by-outcome/ 301
/guidance/skills/catalogue /docs/ki-agentic-harness/skill-catalogue/ 301
/guidance/using-ki /docs/ki-agentic-harness/how-the-harness-works/ 301
/guidance/using-ki/command-line-interface /docs/ki/naming-and-locations/ 301
/guidance/using-ki/getting-started /docs/ki/getting-started/ 301
