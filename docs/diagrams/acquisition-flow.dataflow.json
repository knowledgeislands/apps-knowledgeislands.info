  "cards": [
    {
      "dot": "cyan",
      "title": "Capture preserves evidence",
      "items": [
        "Ordinary learning uses durable guidance; full agent-session import is an exception.",
        "ChatGPT imports one user-prepared readable capture; Granola reads owned notes.",
        "Required originals retain exact bytes, names, sizes and checksums."
      ]
    },
    {
      "dot": "amber",
      "title": "The receiving island decides",
      "items": [
        "Dispatch moves a whole package or roll-up into +/_ACQUIRED/.",
        "Receiver triage is distinguishable metadata in the existing capture package.",
        "Delivery grants no canonical adoption, source mutation or retirement authority."
      ]
    },
    {
      "dot": "emerald",
      "title": "Pulse is a separate bounded route",
      "items": [
        "At most ten leads produce at most five cited observations per Scan.",
        "Each signal gets Read / learn, Watch, Act or Discard.",
        "Without explicit handoff authority and a destination owner, output stays transient."
      ]
    }
  ]
