{"schema_version":3,"diagram_type":"lifecycle","meta":{"title":"A finding from the owner's request to its home","locale":"en","output":"docs/diagrams/finding-life.html","quality_profile":"showcase","repository":{"url":"https://github.com/knowledgeislands/ki-principal","revision":"f3297dcb635ea7c2b3202084c4b613243fa95a14"}},"mainPath":["requested","opened","carried","settled","homed"],"states":[{"id":"requested","type":"start","label":"Requested","sublabel":"the owner asks","tag":"owner's words","step":"01","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":29,"end_line":33}]},{"id":"opened","type":"active","label":"Opened","sublabel":"tag, goal, scope, table","tag":"findings/<tag>.md","step":"02","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":35,"end_line":52}]},{"id":"carried","type":"waiting","label":"Carried","sublabel":"in every report","tag":"until settled","step":"03","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":54,"end_line":56}]},{"id":"refreshed","type":"active","label":"Refreshed","sublabel":"As of moves, rows say done","tag":"facts changed","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":91,"end_line":93}]},{"id":"settled","type":"decision","label":"Settled","sublabel":"mark or owner's word","tag":"decisions log","step":"04","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":58,"end_line":61}]},{"id":"homed","type":"success","label":"Homed","sublabel":"record, note or log","tag":"durable","step":"05","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":63,"end_line":67}]},{"id":"dropped","type":"neutral","label":"Dropped","sublabel":"served its purpose; Git keeps it","tag":"one log line","sources":[{"path":"+/_WORK/ki.ways-of-working/design/findings.md","line":68,"end_line":68}]}],"transitions":[{"id":"request-open","from":"requested","to":"opened","label":"write"},{"id":"open-carry","from":"opened","to":"carried","label":"report"},{"id":"carry-refresh","from":"carried","to":"refreshed","label":"facts move","variant":"dashed"},{"id":"refresh-carry","from":"refreshed","to":"carried","label":"re-read","variant":"dashed"},{"id":"carry-settle","from":"carried","to":"settled","label":"mark","variant":"emphasis"},{"id":"settle-home","from":"settled","to":"homed","label":"homed"},{"id":"settle-drop","from":"settled","to":"dropped","label":"dropped"}],"cards":[{"dot":"cyan","title":"Only a request makes a finding","items":["A survey, table, comparison or assessment the owner asked for","A run's own observations and a check's results stay in Done","A finding is evidence; what changed is still Done"]},{"dot":"amber","title":"Carried in full","items":["Shown under Findings, after In Progress and before Queries","Repeated table and all, never by reference to an earlier reply","Lives as findings/<tag>.md in the work folder between reports"]},{"dot":"rose","title":"Findings and queries are settled apart","items":["Each decision a finding calls for is a query of its own","Answering the queries does not settle the finding","Settling the finding does not answer its queries"]}]}
