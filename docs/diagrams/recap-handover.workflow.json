    {
      "dot": "cyan",
      "title": "Ground the whole live thread",
      "items": [
        "Recap and compaction do not reset coverage.",
        "Recheck commits, gates and session-owned file state in every repository.",
        "Transcript evidence is advisory; unavailable evidence is not clean evidence."
      ]
    },
    {
      "dot": "amber",
      "title": "Recorded deferrals are distinct",
      "items": [
        "An agreed follow-up needs a verified canonical roadmap or Stream home.",
        "Once captured, its remaining lifecycle is not a thread Action.",
        "An unwritten agreed handoff or undecided learning route remains outstanding."
      ]
    },
    {
      "dot": "emerald",
      "title": "Outputs preserve the next scope",
      "items": [
        "Discussion coverage is optional and bounded by available evidence.",
        "Actions is a checklist for the user, not permission to act unprompted.",
        "Offer documented compaction at a safe boundary; a digest is not context reduction.",
        "A portable checkpoint hand-off needs explicit checkpoint <thread>."
      ]
    }
