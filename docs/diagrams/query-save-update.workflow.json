    {
      "dot": "cyan",
      "title": "Read before answering or editing",
      "items": [
        "Use provisioned bounded search; fall back to literal search and targeted reads.",
        "A search index finds notes; current note evidence supports the answer.",
        "UPDATE enriches a freshly read note and preserves its structure."
      ]
    },
    {
      "dot": "amber",
      "title": "Writing respects the island",
      "items": [
        "Propose the destination and filename, cite facts and confirm the write.",
        "Where Enactment applies, substantive canonical changes use approved forward work.",
        "Trivial fixes and authorised factual profile auto-appends retain narrow exceptions."
      ]
    },
    {
      "dot": "emerald",
      "title": "Digests are produced outputs",
      "items": [
        "DIGEST uses Context, Decisions, Facts Learned, Related Work and Keywords.",
        "It carries note_type: session-digest and retain_until, normally 30 days ahead.",
        "Extract useful knowledge before discarding it; keep the README scaffold."
      ]
    }
  ]
